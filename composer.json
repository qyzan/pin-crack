{
    "name": "qyzan/pin-crack",
    "description": "Offline recovery of short secrets (PINs) from leaked password hashes - built to quantify keyspace risk during authorized security testing.",
    "type": "project",
    "keywords": ["security", "pentest", "bcrypt", "argon2", "password-cracking", "pin", "keyspace"],
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "PinCrack\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PinCrack\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/pin-crack"],
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": [
            "@analyse",
            "@test"
        ]
    }
}
